/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include "nicenano_zigbee_nrf52840-pinctrl.dtsi"

/ {
    model = "nice!nano nRF52840 Zigbee prototype";
    compatible = "custom,nicenano-zigbee-nrf52840";

    chosen {
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,code-partition = &slot0_partition;
        zephyr,ieee802154 = &ieee802154;
        ncs,zigbee-timer = &timer2;
    };

    aliases {
        motor-uart = &uart0;
    };
};

/*
 * DIAGNOSTIC FLASH LAYOUT ONLY — NOT VERIFIED AGAINST OUR UF2 BOOTLOADER.
 * Lower and upper bounds checked against Adafruit Bootloader 0.6.0:
 *   src/usb/uf2/uf2cfg.h USER_FLASH_END=0xAD000
 *   linker/nrf52840.ld bootloader start=0xF4000
 * Actual HW-954 ROM/UICR contents and vector handoff remain unverified.
 *
 *   0x00000-0x25fff  Existing S140 / reserved region
 *   0x26000-0xacfff  UF2-writeable application (Adafruit 0.6.0)
 *   0xad000-0xebfff  Reserved to limit firmware to UF2 v0.6.0 range
 *   0xec000-0xeffff  ZBOSS NVRAM (16 KiB)
 *   0xf0000-0xf0fff  ZBOSS production config
 *   0xf1000-0xf3fff  Reserved storage
 *   0xf4000-0xfffff  UF2 bootloader / reserved region
 *
 * Do not flash firmware built with this layout until the physical
 * board's bootloader, vector-table offset and memory map are verified.
 */
&flash0 {
    partitions {
        ranges;
        #address-cells = <1>;
        #size-cells = <1>;

        softdevice_partition: partition@0 {
            compatible = "zephyr,mapped-partition";
            label = "reserved-softdevice";
            reg = <0x00000000 0x00026000>;
        };

        slot0_partition: partition@26000 {
            compatible = "zephyr,mapped-partition";
            label = "image-0";
            reg = <0x00026000 0x00087000>;
        };

        /* Adafruit bootloader 0.6.0 explicitly limits APP writes to
         * target addresses strictly below 0xAD000 (uf2cfg.h).
         * Do NOT let a linked firmware grow into this reserved gap.
         */
        uf2_app_guard: partition@ad000 {
            compatible = "zephyr,mapped-partition";
            label = "reserved-uf2-app-guard";
            read-only;
            reg = <0x000ad000 0x0003f000>;
        };

        zboss_nvram: partition@ec000 {
            compatible = "zephyr,mapped-partition";
            label = "zboss-nvram";
            reg = <0x000ec000 0x00004000>;
        };

        zboss_product_config: partition@f0000 {
            compatible = "zephyr,mapped-partition";
            label = "zboss-product-config";
            reg = <0x000f0000 0x00001000>;
        };

        storage_partition: partition@f1000 {
            compatible = "zephyr,mapped-partition";
            label = "storage";
            reg = <0x000f1000 0x00003000>;
        };

        uf2_bootloader_partition: partition@f4000 {
            compatible = "zephyr,mapped-partition";
            label = "reserved-uf2-bootloader";
            reg = <0x000f4000 0x0000c000>;
        };
    };
};

&reg0 { status = "okay"; };
&reg1 { regulator-initial-mode = <NRF5X_REG_MODE_DCDC>; };
&gpio0 { status = "okay"; };
&gpio1 { status = "okay"; };
&gpiote { status = "okay"; };

&uart0 {
    compatible = "nordic,nrf-uarte";
    status = "okay";
    current-speed = <9600>;
    pinctrl-0 = <&uart0_default>;
    pinctrl-1 = <&uart0_sleep>;
    pinctrl-names = "default", "sleep";
};

&timer2 { status = "okay"; };
&ieee802154 { status = "okay"; };
